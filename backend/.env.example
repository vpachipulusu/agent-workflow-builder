# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# If using API Key auth instead of DefaultAzureCredential:
# AZURE_OPENAI_API_KEY=your-api-key

# Weekend Saver (see docs/weekend-saver.md)
# Run against an in-memory fake of Azure:
# WEEKEND_SAVER_DEMO=1
# Pages allowed to drive Weekend Saver; the first is used in the one-time link:
# FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# HTTPS webhook that receives each run report:
# WEEKEND_SAVER_WEBHOOK_URL=https://example.com/hook
